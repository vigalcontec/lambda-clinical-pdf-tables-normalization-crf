# Environment Configuration
ENVIRONMENT=dev
AWS_REGION=eu-west-1

# Logging
LOG_LEVEL=INFO

# AWS Lambda Powertools
POWERTOOLS_SERVICE_NAME=clinical-pdf-normalization
POWERTOOLS_TRACE_DISABLED=true

# DynamoDB Configuration (for job tracking)
DYNAMODB_TABLE_NAME=clinical-pdf-jobs-crf-dev

# Bedrock Configuration (Claude AI)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# S3 Configuration (for JSONL output)
BUSINESS_BUCKET_NAME=datalake-business-vigalcontec-dev-002332700133
OUTPUT_PREFIX=crf/clinical_tables
